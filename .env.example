# ==============================================================================
# PARAKH Platform — Local & Container Environment Configuration
# ==============================================================================

# PostgreSQL Container Credentials
POSTGRES_DB=parakh
POSTGRES_USER=parakh
POSTGRES_PASSWORD=parakh_password

# Database Connection (Container networking: uses postgres service hostname)
DATABASE_URL=postgresql+psycopg://parakh:parakh_password@postgres:5432/parakh

# Security & JWT Configuration
SECRET_KEY=parakh-super-secret-key-change-in-production-0987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Assessment Engine Configuration ("mock" for deterministic prototype; "ml" for production model)
ASSESSMENT_ENGINE=mock

# Application Diagnostics
DEBUG=false
APP_ENV=production

# Frontend API URL Configuration
# Browser-facing API endpoint (accessed by client browsers via published host port)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Internal container-to-container endpoint (accessed by Node.js server inside Docker network)
INTERNAL_API_URL=http://backend:8000

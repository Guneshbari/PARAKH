{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@parakh/types": ["../../packages/types/index.ts"],
      "@parakh/design-tokens": ["../../packages/design-tokens/index.ts"],
      "@parakh/validation": ["../../packages/validation/index.ts"],
      "@parakh/api": ["../../packages/api/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}

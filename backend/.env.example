APP_NAME=PARAKH API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Configuration (Example credentials for local development)
DATABASE_URL=postgresql+psycopg://parakh:parakh_password@localhost:5432/parakh

# Security & JWT Configuration
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

